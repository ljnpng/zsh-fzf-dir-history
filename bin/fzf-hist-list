#!/bin/bash
# Generate deduplicated history entries for fzf
# Fields: search command, display, directory, hex-encoded source record
hist="${ZFH_HISTORY_FILE:-$HOME/.zsh_dir_history}"
export _ZFH_FILTER_DIR="${1-}"
reverse() { if command -v tac >/dev/null; then tac; else tail -r; fi; }
LC_ALL=C reverse < "$hist" | LC_ALL=C awk -F'\t' '
BEGIN {
  for (byte = 0; byte < 256; byte++) byte_values[sprintf("%c", byte)] = byte
}
function encode_record(record, encoded, position) {
  encoded = ""
  for (position = 1; position <= length(record); position++)
    encoded = encoded sprintf("%02x", byte_values[substr(record, position, 1)])
  return encoded
}
{
  source_record = $0
  gsub(/[[:space:]]+$/, "", $2)
} (ENVIRON["_ZFH_FILTER_DIR"] == "" || $1 == ENVIRON["_ZFH_FILTER_DIR"]) && !seen[$1"\t"$2]++ {
  n = split($1, a, "/")
  dir = (n > 1 ? a[n-1] "/" a[n] : a[n])
  printf "%s\t%s  \033[90m%s\033[0m\t%s\t%s\n", $2, $2, dir, $1, encode_record(source_record)
}'
